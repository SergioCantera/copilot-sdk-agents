# Local development can use the signed-in GitHub Copilot CLI.
# The container sets MODEL_BACKEND=foundry for hosted deployment.
MODEL_BACKEND=github

# Set MODEL_BACKEND=foundry only when testing a Foundry deployment.
# The model value is the Foundry model deployment name.
FOUNDRY_MODEL_NAME=
FOUNDRY_MODEL_URL=
FOUNDRY_BEARER_TOKEN=

# Optional HTTP/SSE MCP server for local orchestration tests.
MCP_SERVER_URL=
