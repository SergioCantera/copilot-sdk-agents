{
  "name": "copilot-demo-foundry",
  "version": "0.1.0",
  "private": true,
  "description": "A Copilot SDK orchestrator prepared for Microsoft Foundry hosting.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
