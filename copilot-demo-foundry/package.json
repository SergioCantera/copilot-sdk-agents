  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.22"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
